# Copy to .env.local and fill in values locally. Never commit real values.

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---
# Neon PostgreSQL connection string.
DATABASE_URL=
# Signs Circuit session cookies. At least 32 random characters.
CIRCUIT_SESSION_SECRET=
# Jupiter developer-portal API key. Required when CIRCUIT_JUPITER_MODE=live.
JUPITER_API_KEY=
# Pyth Pro key. Public-equity references need a key with US-equity entitlement.
PYTH_API_KEY=
# Reserved for encrypting persisted provider JWTs. Currently unused (the Jupiter JWT lives only in an HttpOnly cookie).
CIRCUIT_TOKEN_ENCRYPTION_KEY=

# --- Server config ---
# mock | live. Mock execution is always labelled SIMULATED in the UI. Production uses live.
CIRCUIT_JUPITER_MODE=mock
# Optional explicit provider base URLs. Tests may point PYTH_BASE_URL at a local fixture server.
JUPITER_TRIGGER_BASE_URL=
PYTH_BASE_URL=

# --- Public values (inlined into browser bundles) ---
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# The canonical origin. It appears in the wallet sign-in message and decides the Secure cookie flag.
# Production must use its HTTPS URL, never localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
